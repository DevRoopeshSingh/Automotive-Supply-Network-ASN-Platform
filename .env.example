# ASN Master Platform - Local Development Environment Variables

# Infrastructure
DATABASE_URL=postgresql://asn_user:asn_password@localhost:5432/asn_dev?schema=public
REDIS_URL=redis://localhost:6379
DB_PORT=5432
DB_USER=asn_user
DB_PASSWORD=asn_password
DB_NAME=asn_dev
REDIS_PORT=6379

# API Server
PORT=4000
NODE_ENV=development
JWT_SECRET=asn_super_secret_jwt_key_with_at_least_32_characters_long
JWT_REFRESH_SECRET=asn_super_secret_refresh_jwt_key_with_at_least_32_chars
CORS_ORIGIN=*

# Web Applications Ports & URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
BUYER_WEB_PORT=3000
SUPPLIER_WEB_PORT=3001
ADMIN_WEB_PORT=3002
