# =============================================================================
# ASN Production Environment Template (.env.production)
# Copy this file to .env.production on the host server (chmod 600)
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=4000

# PostgreSQL 16 + PostGIS 3.4
DB_NAME=asn_prod
DB_USER=asn_prod_user
# Generate with: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 20
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DATABASE_URL=postgresql://asn_prod_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/asn_prod?schema=public

# Redis 7 Cache & Distributed Locks
# Generate with: openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 24
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379

# JWT Security Secrets (Must be at least 32 characters long)
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_SECRET_FROM_OPENSSL
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_HEX_SECRET

# Strict Production Guard: NEVER set to true in production
ALLOW_DEV_OTP=false

# Allowed Web Origins (comma-separated, no trailing slashes)
CORS_ORIGIN=https://asn.in,https://buyer.asn.in,https://supplier.asn.in,https://admin.asn.in

# Frontend Public API URL (consumed during build)
NEXT_PUBLIC_API_URL=https://api.asn.in/api/v1

# Cloudflare R2 / AWS S3 Object Storage
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=asn-production-assets
R2_PUBLIC_URL=https://assets.asn.in

# Transactional SMS / OTP Provider (India DLT Compliant)
OTP_PROVIDER_TYPE=msg91
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_SENDER_ID=ASNIND
MSG91_DLT_TE_ID=YOUR_DLT_TEMPLATE_ID

# Payment Gateway (Phase 4 Ready)
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET
